<?xml version="1.0" encoding="UTF-8"?>
<!--
  Only used to resolve the subset of the AWS SDK v2 that hadoop-aws needs, see the Dockerfile.
  The standalone-metastore base image ships hadoop-aws but not the SDK. Using the individual modules instead of the
  `software.amazon.awssdk:bundle` artifact that hadoop-aws depends on saves ~540MB.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.miracum.util-images</groupId>
  <artifactId>hive-metastore-aws-sdk</artifactId>
  <version>0.0.0</version>
  <packaging>pom</packaging>

  <properties>
    <!-- must match `aws-java-sdk-v2.version` in https://github.com/apache/hadoop/blob/rel/release-3.4.1/hadoop-project/pom.xml -->
    <aws-sdk-v2.version>2.24.6</aws-sdk-v2.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>${aws-sdk-v2.version}</version>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3-transfer-manager</artifactId>
      <version>${aws-sdk-v2.version}</version>
    </dependency>
    <!-- for the assumed-role and web identity credential providers -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sts</artifactId>
      <version>${aws-sdk-v2.version}</version>
    </dependency>
  </dependencies>
</project>
